# Variáveis do backend Flask (opcional). No Live Server nada disto é usado.

# Chave das sessões. Se vazia, o app gera uma e guarda em data/secret_key.
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria

# Conta de administrador criada na primeira execução.
# Localmente (SQLite) sem ADMIN_PASSWORD, é criada admin / demo123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# 1 = permite "Criar conta" na tela de login; 0 = desativa.
ALLOW_REGISTRATION=1

# PostgreSQL (produção). Vazio = SQLite em data/app.db.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# 1 somente quando o site estiver em HTTPS.
SESSION_COOKIE_SECURE=0
